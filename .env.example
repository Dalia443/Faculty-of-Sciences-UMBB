# Copy this file to ".env" (or ".env.local") and adapt the values.

# Base URL of the future REST API (no trailing slash).
# Example: http://localhost:8000  or  https://your-api.onrender.com
VITE_API_URL=http://localhost:8000

# true  = demonstration mode (in-browser demo data, NO backend needed)
# false = real mode (calls VITE_API_URL: /api/departments, /api/announcements, ...)
VITE_USE_DEMO=true

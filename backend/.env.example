# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Le fichier .env ne doit JAMAIS être partagé ni publié (il est ignoré par Git).

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=faculty_portal
DB_USER=postgres
DB_PASSWORD=METTEZ_ICI_VOTRE_MOT_DE_PASSE_POSTGRESQL

# --- Sécurité JWT ---
# Générez une valeur aléatoire avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=GENEREZ_UNE_CLE_ALEATOIRE_D_AU_MOINS_32_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Application ---
# development : documentation Swagger activée / production : désactivée
ENVIRONMENT=development
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
